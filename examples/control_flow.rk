# Control Flow: If/Elif/Else, While, For-In loops

let score = 88

if score >= 90:
    println("Grade: A+")
elif score >= 80:
    println("Grade: A")
elif score >= 70:
    println("Grade: B")
else:
    println("Grade: F")

# For loop with range
mut evens = []
for i in range(1, 11):
    if i % 2 == 0:
        push(evens, i)

println("Even numbers from 1 to 10: {evens}")
